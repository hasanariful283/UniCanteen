generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id
  email     String?  @unique
  name      String?
  phone     String? // @unique
  studentId String?
  userRole  RoleType @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canteens        Canteen[]
  Customer        Customer?
  DeliveryPerson   DeliveryPerson?

  // Messaging relations
  conversationParticipants ConversationParticipant[]
  messages                 Message[]

  // Notification relations
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationSender")
}

enum RoleType {
  CANTEEN_OWNER
  CUSTOMER
  DELIVERY_PERSON
  ADMIN
  DEFAULT
}

enum CanteenName {
  Khans_Kitchen
  Olympia_Cafe
  Neptune_Cafe
}

model Canteen {
  id            String      @id
  name          CanteenName
  canteen_image String?
  ownerId       String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  owner       User             @relation(fields: [ownerId], references: [id])
  reviews     CanteenReviews[]
  CanteenFood CanteenFood[]
  reports     CustomerReport[]

  // orders Order[]
  OrderFoodItem OrderFoodItem[]
}

enum FoodCategory {
  POPULAR
  BREAKFAST
  LUNCH
  DINNER
  FAST_FOOD
  DESSERT
  BEVERAGE
  SNACK
  RICE_ITEMS
  DRINKS
  PACKET_ITEMS
  OTHERS
  MEAT_ITEMS
}

model CanteenFood {
  id           String   @id @default(cuid())
  canteenId    String
  name         String
  price        Float
  image        String?
  rating       Float
  description  String?
  availability Boolean  @default(true)
  stocks       Int      @default(10)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category      FoodCategory[]
  canteen       Canteen         @relation(fields: [canteenId], references: [id])
  featuredItems FeaturedItems[]
  cartItems     CartItem[]
  OrderFoodItem OrderFoodItem[]
}


model CanteenReviews {
  id        String   @id @default(cuid())
  canteenId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  canteen Canteen @relation(fields: [canteenId], references: [id])
  customer    Customer    @relation(fields: [userId], references: [userId])

  @@unique([canteenId, userId])
}

model Customer {
  userId    String   @id
  uiuId     String   // @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ordersPlaced Order[] @relation("CustomerOrders")
  user         User    @relation(fields: [userId], references: [id])
  cart         Cart?
  canteenReviews CanteenReviews[]
  vouchers     Voucher[]
  reports      CustomerReport[]
}

model FeaturedItems {
  id          String      @id @default(cuid())
  bannerImage String?
  isFeatured  Boolean     @default(false)
  foodId      String
  food        CanteenFood @relation(fields: [foodId], references: [id])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// --------------------------Order And Cart--------------------------\

model Cart {
  id         String   @id @default(cuid())
  customerId String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer   @relation(fields: [customerId], references: [userId])
  items    CartItem[]
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  foodId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  food CanteenFood @relation(fields: [foodId], references: [id])
  @@unique([cartId, foodId])
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERING
  DELIVERED
  CANCELLED
}


model DeliveryPerson {
  userId    String   @id
  uiuId     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
  DeliveryProfile DeliveryProfile?

  // relations with Order
  deliveries Order[] @relation("OrderDeliveryMan") // user as delivery person
  
  // Reports filed against this delivery person
  reports CustomerReport[]
}

model DeliveryProfile {
  id          String  @id @default(cuid())
  userId      String  @unique
  isAvailable Boolean @default(false) // delivery ON/OFF button
  rating      Float? // avg rating from deliveries
  completed   Int     @default(0)
  cancelled   Int     @default(0)
  
  // Profile settings
  phone       String?
  address     String?
  vehicleType String? // "bike", "bicycle", "car", etc.
  
  // Notification preferences
  orderNotifications    Boolean @default(true)
  messageNotifications  Boolean @default(true)
  earningsNotifications Boolean @default(false)
  promotionNotifications Boolean @default(false)
  soundEnabled         Boolean @default(true)
  
  // Privacy settings
  showPhoneToCustomers    Boolean @default(true)
  showLocationWhenOnline  Boolean @default(true)
  allowCustomerRatings    Boolean @default(true)
  
  // App preferences
  language String @default("en")
  theme    String @default("light") // "light", "dark", "auto"
  
  // Default working hours (used for time slots)
  defaultStartTime String @default("09:00") // Format: "HH:mm"
  defaultEndTime   String @default("22:00") // Format: "HH:mm"
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveryPerson DeliveryPerson @relation(fields: [userId], references: [userId])
  timeSlots DeliveryTimeSlot[]
}

model DeliveryTimeSlot {
  id         String   @id @default(cuid())
  deliveryId String
  dayOfWeek  WeekDay
  startTime  String   // Format: "HH:mm" (e.g., "09:00")
  endTime    String   // Format: "HH:mm" (e.g., "22:00")
  isActive   Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  delivery DeliveryProfile @relation(fields: [deliveryId], references: [id])
}

model Order {
  id         String        @id @default(cuid())
  customerId String
  status     OrderStatus   @default(PENDING)
  totalPrice Float
  deliveryAt DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  assignedTo String?

  customer   Customer          @relation("CustomerOrders", fields: [customerId], references: [userId])
  foodItems  OrderFoodItem[]   // individual items from potentially different canteens
  deliveryMan DeliveryPerson?  @relation("OrderDeliveryMan", fields: [assignedTo], references: [userId])

  // Messaging relation (one order may have one or more conversations)
  conversations Conversation[]
  
  // Notification relation
  notifications Notification[]
  
  // Reports relation
  reports       CustomerReport[]
}

model OrderFoodItem {
  id        String       @id @default(cuid())
  orderId   String
  foodId    String
  canteenId String
  quantity  Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  order    Order         @relation(fields: [orderId], references: [id])
  food     CanteenFood   @relation(fields: [foodId], references: [id])
  canteen  Canteen       @relation(fields: [canteenId], references: [id])
  reports  CustomerReport[]
}

// --------------------------Messaging--------------------------

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model Conversation {
  id         String    @id @default(cuid())
  orderId    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  order        Order?                   @relation(fields: [orderId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  content        String
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
}



// Voucher System
model Voucher {
  id          String   @id @default(cuid())
  customerId  String
  discount    Float
  usageLimit  Int?     // null = unlimited
  usedCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  customer Customer @relation(fields: [customerId], references: [userId])
}

// --------------------------Notifications--------------------------

enum NotificationType {
  ORDER_ASSIGNED       // When an order is assigned to delivery person
  ORDER_CANCELLED      // When an order is cancelled
  ORDER_READY          // When canteen marks order as ready for pickup
  ORDER_UPDATE         // When order status is updated
  URGENT_MESSAGE       // When someone sends urgent message
  SYSTEM_ALERT         // System-wide alerts
  PAYMENT_UPDATE       // Payment related notifications
  REPORT_SUBMITTED     // When a customer submits a report
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String          // User who receives the notification
  senderId    String?         // User who triggered the notification (optional for system notifications)
  type        NotificationType
  title       String
  content     String
  isRead      Boolean         @default(false)
  orderId     String?         // Related order if applicable
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id])
  order     Order? @relation(fields: [orderId], references: [id])

  @@index([recipientId, isRead])
  @@index([createdAt])
}

model CustomerReport {
  id          String   @id @default(cuid())
  type        ReportType
  title       String
  description String?
  status      ReportStatus @default(PENDING)
  priority    ReportPriority @default(MEDIUM)
  rating      Int?     // 1-5 star rating
  response    String?  // Canteen's response to the report
  
  // Relations
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [userId])
  
  canteenId   String
  canteen     Canteen  @relation(fields: [canteenId], references: [id])
  
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id])
  
  foodItemId  String?
  foodItem    OrderFoodItem? @relation(fields: [foodItemId], references: [id])
  
  deliveryPersonId String?
  deliveryPerson   DeliveryPerson? @relation(fields: [deliveryPersonId], references: [userId])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("customer_reports")
}

enum ReportType {
  FOOD_QUALITY
  SERVICE
  HYGIENE
  DELIVERY
  PRICING
  OTHER
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}



