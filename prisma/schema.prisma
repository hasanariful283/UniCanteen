// generator client {
//   provider = "prisma-client-js"
// }
generator client {
  provider = "prisma-client" // Changed from "prisma-client-js"
  output   = "../src/generated"
  // Add these two lines to fix enum exports:
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                    @id
  email                    String?                   @unique
  name                     String?
  phone                    String?
  studentId                String?
  userRole                 RoleType                  @default(DEFAULT)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  canteens                 Canteen[]
  conversationParticipants ConversationParticipant[]
  Customer                 Customer?
  DeliveryPerson           DeliveryPerson?
  messages                 Message[]
  notificationsReceived    Notification[]            @relation("NotificationRecipient")
  notificationsSent        Notification[]            @relation("NotificationSender")
}

model Canteen {
  id            String           @id
  name          CanteenName
  canteen_image String?
  ownerId       String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  owner         User             @relation(fields: [ownerId], references: [id])
  CanteenFood   CanteenFood[]
  reviews       CanteenReviews[]
  OrderFoodItem OrderFoodItem[]
  reports       CustomerReport[]
}

model CanteenFood {
  canteenId     String
  name          String
  price         Float
  image         String?
  rating        Float
  description   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  availability  Boolean         @default(true)
  stocks        Int             @default(10)
  category      FoodCategory[]
  id            String          @id @default(cuid())
  canteen       Canteen         @relation(fields: [canteenId], references: [id])
  cartItems     CartItem[]
  featuredItems FeaturedItems[]
  OrderFoodItem OrderFoodItem[]
}

model CanteenReviews {
  canteenId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  id        String   @id @default(cuid())
  userId    String
  canteen   Canteen  @relation(fields: [canteenId], references: [id])
  customer  Customer @relation(fields: [userId], references: [userId])
}

model Customer {
  userId         String           @id
  uiuId          String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  canteenReviews CanteenReviews[]
  cart           Cart?
  user           User             @relation(fields: [userId], references: [id])
  ordersPlaced   Order[]          @relation("CustomerOrders")
  vouchers       Voucher[]
  reports        CustomerReport[]
}

model FeaturedItems {
  id          String      @id @default(cuid())
  bannerImage String?
  isFeatured  Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  foodId      String
  food        CanteenFood @relation(fields: [foodId], references: [id])
}

model Cart {
  id         String     @id @default(cuid())
  customerId String     @unique
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  customer   Customer   @relation(fields: [customerId], references: [userId])
  items      CartItem[]
}

model CartItem {
  id        String      @id @default(cuid())
  cartId    String
  foodId    String
  quantity  Int         @default(1)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cart      Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  food      CanteenFood @relation(fields: [foodId], references: [id])

  @@unique([cartId, foodId])
}

model DeliveryPerson {
  userId          String           @id
  uiuId           String           @unique
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  DeliveryProfile DeliveryProfile?
  deliveries      Order[]          @relation("OrderDeliveryMan")
  reports         CustomerReport[]
}

model DeliveryProfile {
  id                     String             @id @default(cuid())
  userId                 String             @unique
  isAvailable            Boolean            @default(false)
  rating                 Float?
  completed              Int                @default(0)
  cancelled              Int                @default(0)
  address                String?
  allowCustomerRatings   Boolean            @default(true)
  createdAt              DateTime           @default(now())
  defaultEndTime         String             @default("22:00")
  defaultStartTime       String             @default("09:00")
  earningsNotifications  Boolean            @default(false)
  language               String             @default("en")
  messageNotifications   Boolean            @default(true)
  orderNotifications     Boolean            @default(true)
  phone                  String?
  promotionNotifications Boolean            @default(false)
  showLocationWhenOnline Boolean            @default(true)
  showPhoneToCustomers   Boolean            @default(true)
  soundEnabled           Boolean            @default(true)
  theme                  String             @default("light")
  updatedAt              DateTime           @updatedAt
  vehicleType            String?
  deliveryPerson         DeliveryPerson     @relation(fields: [userId], references: [userId])
  timeSlots              DeliveryTimeSlot[]
}

model DeliveryTimeSlot {
  id         String          @id @default(cuid())
  deliveryId String
  dayOfWeek  WeekDay
  startTime  String
  endTime    String
  createdAt  DateTime        @default(now())
  isActive   Boolean         @default(true)
  updatedAt  DateTime        @updatedAt
  delivery   DeliveryProfile @relation(fields: [deliveryId], references: [id])
}

model Order {
  id            String           @id @default(cuid())
  customerId    String
  status        OrderStatus      @default(PENDING)
  totalPrice    Float
  assignedTo    String?
  deliveryAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  conversations Conversation[]
  notifications Notification[]
  deliveryMan   DeliveryPerson?  @relation("OrderDeliveryMan", fields: [assignedTo], references: [userId])
  customer      Customer         @relation("CustomerOrders", fields: [customerId], references: [userId])
  foodItems     OrderFoodItem[]
  reports       CustomerReport[]
}

model OrderFoodItem {
  id        String           @id @default(cuid())
  orderId   String
  foodId    String
  canteenId String
  quantity  Int              @default(1)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  canteen   Canteen          @relation(fields: [canteenId], references: [id])
  food      CanteenFood      @relation(fields: [foodId], references: [id])
  order     Order            @relation(fields: [orderId], references: [id])
  reports   CustomerReport[]
}

model Conversation {
  id           String                    @id @default(cuid())
  orderId      String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  order        Order?                    @relation(fields: [orderId], references: [id])
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType  @default(TEXT)
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])
}

model Voucher {
  id         String   @id @default(cuid())
  customerId String
  discount   Float
  usageLimit Int?
  usedCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [userId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  senderId    String?
  type        NotificationType
  title       String
  content     String
  isRead      Boolean          @default(false)
  orderId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  order       Order?           @relation(fields: [orderId], references: [id])
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id])
  sender      User?            @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([recipientId, isRead])
  @@index([createdAt])
}

model CustomerReport {
  id               String          @id @default(cuid())
  type             ReportType
  title            String
  description      String?
  status           ReportStatus    @default(PENDING)
  priority         ReportPriority  @default(MEDIUM)
  rating           Int?
  response         String?
  customerId       String
  canteenId        String
  orderId          String?
  foodItemId       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deliveryPersonId String?
  canteen          Canteen         @relation(fields: [canteenId], references: [id])
  customer         Customer        @relation(fields: [customerId], references: [userId])
  deliveryPerson   DeliveryPerson? @relation(fields: [deliveryPersonId], references: [userId])
  foodItem         OrderFoodItem?  @relation(fields: [foodItemId], references: [id])
  order            Order?          @relation(fields: [orderId], references: [id])

  @@map("customer_reports")
}

enum RoleType {
  CANTEEN_OWNER
  CUSTOMER
  DELIVERY_PERSON
  ADMIN
  DEFAULT
}

enum CanteenName {
  Khans_Kitchen
  Olympia_Cafe
  Neptune_Cafe
}

enum FoodCategory {
  POPULAR
  BREAKFAST
  LUNCH
  DINNER
  FAST_FOOD
  DESSERT
  BEVERAGE
  SNACK
  RICE_ITEMS
  DRINKS
  PACKET_ITEMS
  OTHERS
  MEAT_ITEMS
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum OrderStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  CANCELLED
  DELIVERING
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

enum NotificationType {
  ORDER_ASSIGNED
  ORDER_CANCELLED
  ORDER_READY
  URGENT_MESSAGE
  SYSTEM_ALERT
  PAYMENT_UPDATE
  ORDER_UPDATE
  REPORT_SUBMITTED
}

enum ReportType {
  FOOD_QUALITY
  SERVICE
  HYGIENE
  DELIVERY
  PRICING
  OTHER
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
